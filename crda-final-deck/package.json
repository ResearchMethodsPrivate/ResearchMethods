{
  "name": "crda-final-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ECS7029P final presentation: our reproduction of CRDA (draft)",
  "scripts": {
    "dev": "vite",
    "collect": "tsx scripts/collect.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "notes": "tsx scripts/export-notes.ts",
    "pdf": "tsx scripts/export-pdf.ts",
    "validate": "tsx scripts/validate.ts",
    "validate:ready": "tsx scripts/validate.ts --ready",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "npm run build && tsx --test tests/browser/*.test.ts",
    "shots": "npm run build && tsx scripts/shots.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/inter-tight": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "gsap": "^3.13.0",
    "reveal.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/reveal.js": "^5.2.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
